---
interface Props {
  /** 並べ替え済みのお知らせ */
  items: readonly {
    id: string;
    date: string;
    title: string;
    body?: string | undefined;
  }[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="section" aria-labelledby="news-title">
    <h2 class="section__title" id="news-title">
      お知らせ
    </h2>
    <ul class="timeline">
      {items.map((item) => (
        <li class="timeline__item">
          <time class="timeline__when" datetime={item.date}>
            {item.date.replaceAll("-", ".")}
          </time>
          <div>
            <p class="timeline__title">{item.title}</p>
            {item.body && <p class="timeline__text">{item.body}</p>}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
